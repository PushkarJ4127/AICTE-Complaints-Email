# Use the SAME Supabase project URL and public anon/publishable key for both pages.
# Get these from Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Brevo transactional email (SMTP REST API)
VITE_BREVO_API_KEY=your_brevo_api_key
VITE_BREVO_SENDER_EMAIL=your_verified_sender@example.com
